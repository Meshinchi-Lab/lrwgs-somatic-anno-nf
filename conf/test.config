/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run Meshinchi-Lab/2026-04-30_WGS_Nanopore_Annotation_T-ALL -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

workDir = './work'

// Global default params, used in configs
params {

    // Input and output options
    input                       = 'data/test_data/sample_sheet_withSavana.csv'
    sample_metadata             = 'data/test_data/wf_metadata.csv'         // optional path to cohort metadata CSV; null skips merge
    ensembl_db                  = 'data/reference/EnsDb.Hsapiens.v110.sqlite'                                                                    // optional path to an Ensembl DB (e.g. EnsDb sqlite) surfaced to the SV_REPORT_INDEX qmd via params$ensembl_db; null = not staged
    outdir                      = 'results/test_set/all_types'
    publish_dir_mode            = 'copy'

    /*
        Structural Variant Options
    */
    // SAVANA
    pon_1kg                     = "1000g_hg38"
    min_support                 = 3 // default is 3 
    allele_min_reads            = 10 // default is 10
    main_cn_step_change         = 2 //the default is 1
    contigs_file                = 'https://raw.githubusercontent.com/cortes-ciriano-lab/savana/refs/heads/main/example/contigs.chr.hg38.txt'

    // Merge with MINDA
    sv_merge_size               = "100"

    // AnnotSV
    annotsv_annotations         = "data/reference/AnnotSV"        // path to pre-built AnnotSV DB; null triggers auto-download
    candidateGenesFile          = 'data/reference/genomic_basis_tall/ST9.alterations_OncoKB_cancer_genes.txt'      // path to genes of interest

    // ── SNV candidate-gene rescue ──────────────────────────────────────
    // Recovers single-caller PASS SNVs inside candidate-gene regions that the
    // `bcftools isec -n+2` consensus would otherwise discard.
    rescue_snv                  = true
    rescue_genes_file           = null   // null = fall back to candidateGenesFile
    rescue_promoter_pad         = 2000   // strand-aware upstream padding, bp

    FtIncludedInSV              = ['data/reference/genomic_basis_tall/ST17_Alterations.SV.All_DEL.bed','data/reference/genomic_basis_tall/ST17_Alterations.SV.All_DUP.bed','data/reference/genomic_basis_tall/ST17_Alterations.SV.All_INS.bed','data/reference/genomic_basis_tall/ST17_Alterations.SV.All_INV.bed']
    SVincludedInFt              = []
    AnyOverlap                  = ['data/reference/genomic_basis_tall/ST17_Alterations.SV.All_BND.bed']
    add_savana_sv               = false       // true = concat Severus + SAVANA-only into AnnotSV input; false = Severus-only (smaller KnotAnnotSV html)

    // VEP for SVs
    sv_anno_vep                 = 'true'
    sv_vcf                      = 'data/gnomad_sv_cnv/gnomad.v4.1.sv.sites.vcf.gz'
    sv_clinvar                  = 'data/clinvar/nstd102.GRCh38.variant_call.vcf.gz'

    /*
        Copy Number Alteration Options
    */
    // AnnotSV — CNA user BEDs (ST19 Recurrent_AMP/DEL/GAIN/LOSS)
    run_cna_anno                = 'true'
    cna_FtIncludedInSV          = [
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_AMP.bed',
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_DEL.bed',
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_GAIN.bed',
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_LOSS.bed'
    ]
    cna_SVincludedInFt          = []
    cna_AnyOverlap              = []

    // ── Cohort SV merge (part 1 of 3) ──────────────────────────────────
    // Clusters SVs ACROSS cohort samples so the same event called at slightly
    // different breakpoints/lengths is recognised as one recurrent variant.
    // Runs AFTER SV_REPORT_INDEX because driver_tier exists only in the report layer.
    run_cohort_merge_sv         = true
    cohort_sv_max_dist          = 500    // PRIMARY clustering gate, bp, applied FLAT
                                         // because --nonlinear_dist is mandatory (see
                                         // conf/modules.config). Calibrated 2026-09-17:
                                         // BND pairs merge at >=300, a 1kb-offset DEL
                                         // needs >=1000. 500 is the conservative middle.
    // NB: there is deliberately NO cohort_sv_max_dist_linear param. Jasmine's length-scaled
    // threshold is max(min_dist, max_dist_linear x SVLEN), and BNDs carry SVLEN=0, which
    // pins them to a flat 100bp that max_dist cannot raise. --nonlinear_dist disables
    // length-scaling entirely and is REQUIRED for BND clustering (10 of 14 tiered rows in
    // the test set are BND), which makes max_dist_linear inert.
    cohort_sv_min_overlap       = 0.5    // secondary, applies within max_dist. Per
                                         // `jasmine --help` this is "the minimum reciprocal
                                         // overlap for DEL/INV/DUP SVs" -- NOT BND.
    cohort_sv_min_seq_id        = 0.5    // applies to INSERTIONS only, so inert for this
                                         // BND/DEL-dominated set; kept permissive because
                                         // ONT breakpoints are noisy and calls are somatic.
    cohort_sv_min_recurrence    = 2      // n_tiered required to set cohort_recurrent
    cohort_sv_region_pad        = 1000   // BED padding, MUST be >= cohort_sv_max_dist or
                                         // region-restriction defeats fuzzy matching

    // CNA annotations
    cnv_vcf                     = 'data/reference/gnomad.v4.1.cnv.all.vcf.gz'

    /*
        Single Nucleotide Variants / INDEL Options
    */
    run_snv_anno               = 'true'
    clinvar_snv_vcf            = 'data/clinvar/clinvar_20260627.vcf.gz'
    civic_snv_vcf              = 'data/reference/01-Jul-2026-civic_accepted.vcf.gz'
    civic_chain                = 'data/reference/hg19ToHg38.over.chain.gz'
    snv_min_vaf                = 0.05    // both callers must show >= this VAF
    snv_gnomad_af_max          = 0.01    // gnomAD AF cutoff for soft PoN

    // VEP
    species                     = 'homo_sapiens'
    cache_version               = '115'
    vep_cache                   = 'data/vep'   // path to pre-built VEP cache directory; null skips VEP annotation
    include_cache               = false      // when vep_cache is null: true = ENSEMBLVEP_DOWNLOAD fetches the cache; false = VEP runs --offline with --custom files only
    vep_extra_files             = []     // list of extra files staged into the VEP working dir (plugins, custom annotations)
    overlap_cutoff              = '80'
    
    // KnotAnnotSV
    knot_config                 = './config_AnnotSV.yaml' // customize the knotannotSV html output

    // Outbound proxy env-file -- null so `-profile test` runs on any host.
    // See nextflow.config for why a non-existent path is fatal (docker exit 125).
    proxy_env_file              = null

    // Locally-staged cytoband ideogram for IGV_REPORTS
    // When null, igv-reports fetches from UCSC at runtime. Setting this with file a file, bypasses the download step, if encountering an curl/ssl errors
    cytoband_ideo               = 'data/reference/cytoBandIdeo.hg38.txt.gz'
    gnomad_sv_track             = "${params.sv_vcf}"   // population-SV annotation track shown in IGV reports; set to null to skip
    gnomad_sv_tbi               = "${params.sv_vcf}.tbi"
    tcr_gene_ref                = "data/reference/HGNC_TCR_genes.tsv"

    // ProteinPaint DISCO plot params (see nextflow.config for details)
    disco_enable                = true
    proteinpaint_host           = 'https://proteinpaint.stjude.org'
    proteinpaint_genome         = 'hg38'

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Schema validation default options
    validate_params            = true
}