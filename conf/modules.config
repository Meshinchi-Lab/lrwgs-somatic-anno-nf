/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    debug = false
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //  SAVANA (tumour-only SV calling) ─
    // COPY-NUMBER: SAVANA's `to` subcommand bundles CN fitting and has NO disable flag 
    //
    // The CN fitting search space is controlled by the existing params `main_cn_step_change` (nextflow.config: 1, conf/test.config: 2)
    //
    // ext.args is passed verbatim to `savana to` for any additional tuning.
    withName: '.*:SAVANA$' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/savana" },
            mode: params.publish_dir_mode,
            // Publish only what downstream consumes plus the CN diagnostic, so a failed
            // fit leaves evidence without copying the whole CN working set.
            pattern: '**/*.{classified.somatic.vcf,classified.somatic.bedpe,No_fit_found*.tsv}'
        ]
    }

    //  DEDUPLICATE_SAVANA ─
    // bcftools view (not vembrane filter): vembrane reorders BND mate pairs so
    // they sit adjacent in the output, breaking positional sort when the mates
    // are at distant coordinates. bcftools view preserves input order strictly
    // and emits bgzipped output via -Oz, removing the need for a TABIX_BGZIP step.
    withName: '.*:DEDUPLICATE_SAVANA:SAVANA_DEDUP_SORT_INPUT' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}.savana.input.sorted" }
    }
    withName: '.*:DEDUPLICATE_SAVANA:BCFTOOLS_VIEW_INS' {
        // -i 'EXPR' includes records matching EXPR; -Oz emits bgzipped VCF
        ext.args   = """-Oz -i 'INFO/SVTYPE=="INS"'"""
        ext.prefix = { "${meta.id}.savana.ins_only" }
    }
    withName: '.*:DEDUPLICATE_SAVANA:BCFTOOLS_VIEW_NON_INS' {
        // -e 'EXPR' excludes records matching EXPR (keeps INS-absent + non-INS)
        ext.args   = """-Oz -e 'INFO/SVTYPE=="INS"'"""
        ext.prefix = { "${meta.id}.savana.non_ins" }
    }
    withName: '.*:DEDUPLICATE_SAVANA:DEDUPLICATE_INS' {
        ext.prefix = { "${meta.id}.savana.ins_only" }
    }
    withName: '.*:DEDUPLICATE_SAVANA:SAVANA_DEDUP_CONCAT' {
        ext.args   = '-Oz --allow-overlaps'
        ext.prefix = { "${meta.id}.savana.deduped" }
    }
    withName: '.*:DEDUPLICATE_SAVANA:SAVANA_DEDUP_SORT' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}.savana.deduped.sorted" }
    }
    withName: '.*:DEDUPLICATE_SAVANA:SAVANA_DEDUP_INDEX' {
        ext.args   = '--tbi'
        ext.prefix = { "${meta.id}.savana.deduped.sorted" }
    }

    //  MERGE_SV 
    withName: '.*:MERGE_SV:BCFTOOLS_REHEADER' {
        ext.args2  = '-Oz'
        ext.prefix = { "${meta.id}.${meta.caller}.reheadered" }
    }

    withName: '.*:MERGE_SV:BCFTOOLS_VIEW' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}.${meta.caller}" }
    }

    withName: '.*:MERGE_SV:BCFTOOLS_SORT' {
        ext.prefix = { "${meta.id}.${meta.caller}.sorted" }
    }

    withName: '.*:MERGE_SV:BCFTOOLS_INDEX' {
        ext.args   = '--tbi'
        ext.prefix = { "${meta.id}.${meta.caller}.sorted" }
    }

    /*
    // MERGING ALGORITHMS
    */
    withName: '.*:MERGE_SV:MINDA' {
        ext.args = ''
        ext.prefix = ''
    }

    withName: '.*:MERGE_SV:SVDB_MERGE' {
        ext.args = '--debug --bnd_distance 100 --overlap 0.95 --ins_distance 100 --pass_only'
        ext.prefix = ''
    }

    withName: '.*:MERGE_SV:SURVIVOR_MERGE' {
        ext.args = ''
        ext.prefix = ''
    }

    //  MINDA_ANNOTATIONS  SAVANA-only sort + index ─
    withName: '.*:MINDA_ANNOTATIONS:BCFTOOLS_SORT' {
        ext.prefix = { "${meta.id}.savana_only.sorted" }
    }

    withName: '.*:MINDA_ANNOTATIONS:BCFTOOLS_INDEX' {
        ext.args   = '--tbi'
        ext.prefix = { "${meta.id}.savana_only.sorted" }
    }

    //  MINDA_ANNOTATIONS  bcftools annotate 
    withName: '.*:MINDA_ANNOTATIONS:BCFTOOLS_ANNOTATE' {
        ext.args   = '-Oz -c CHROM,POS,~ID,INFO/CALLER,INFO/SAVANA_ID,INFO/SAVANA_SVTYPE,INFO/SAVANA_POS,INFO/SAVANA_END,INFO/SAVANA_CHR2,INFO/SAVANA_POS2,INFO/SAVANA_MATEID'
        ext.prefix = { "${meta.id}.severus_annotated" }
    }

    //  ANNOTATIONS_SV  post-concat sort + index 
    withName: 'BCFTOOLS_SORT_MERGED' {
        ext.prefix = { "${meta.id}.merged.sorted" }
    }

    withName: 'BCFTOOLS_INDEX_MERGED' {
        ext.args   = '--tbi'
        ext.prefix = { "${meta.id}.merged.sorted" }
    }

    //  ANNOTATIONS_SV  bcftools concat ─
    withName: '.*:ANNOTATIONS_SV:BCFTOOLS_CONCAT' {
        ext.args   = '-Oz -a'
        ext.prefix = { "${meta.id}.merged" }
    }

    //  ANNOTATIONS_SV  annotation tools ─
    withName: '.*:ANNOTATIONS_SV:BCFTOOLS_REHEADER_SAVANA_FMT' {
        ext.prefix = { "${meta.id}.merged.annotated" }
    }

    // -promoterSize 3000 -tx RefSeq
    withName: 'ANNOTSV_ANNOTSV' {
        ext.args   = "-SVinputInfo 1 -vcf 1 -genomeBuild ${params.genome}"
        ext.prefix = { "${meta.id}.merged.annotated" }
        // Threads the outbound proxy env vars into this process's container.
        // NOTE: `params.proxy_env_file` is set globally in nextflow.config, NOT only under
        // the OPBG profile, so this applies on every profile. Set it to null/'' to disable.
        // `containerOptions` is the per-process scope; `docker.runOptions` is global.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
    }

    withName: 'SVDB_QUERY' {
        ext.prefix = { "${meta.id}.merged.annotated" }
    }

    withName: 'VEMBRANE_TABLE_CALLER' {
        ext.args   = "--header 'ID,CALLER,VAF,hVAF,DR,DV'"
        ext.prefix = { "${meta.id}.caller_lookup" }
    }

    withName: 'ADD_CALLER' {
        ext.prefix = { "${meta.id}.merged.annotated" }
    }

    // KnotAnnotSV is invoked twice (aliased) so we emit BOTH .html and
    // excel from the same custom TSV file from annotsv
    // Each alias gets its own prefix to keep filenames distinct 
    withName: 'KNOTANNOTSV_HTML' {
        ext.args      = { params.genome == "GRCh38" ? "--genomeBuild hg38" : "--genomeBuild ${params.genome}" }
        ext.prefix    = { "${meta.id}.merged.annotated" }
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
        publishDir    = [
            path: { "${params.outdir}/annotations_sv/knotannotsv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'KNOTANNOTSV_XL' {
        ext.args      = { params.genome == "GRCh38" ? "--genomeBuild hg38" : "--genomeBuild ${params.genome}" }
        ext.prefix    = { "${meta.id}.merged.annotated.xl" }
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
        publishDir    = [
            path: { "${params.outdir}/annotations_sv/knotannotsv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANNOTATIONS_SV:ENSEMBLVEP_VEP' {
        ext.args   = {
            // --vcf: bgzipped VCF output (required for bcftools annotate in FILTER_SV)
            // --pick: one consequence per variant in CSQ (avoids per-transcript row explosion)
            def base  = '--fork 4 --vcf --pick --stats_html --stats_text --offline'
            def flags = []
            if ( params.sv_vcf     ) flags << "--custom file=${params.sv_vcf.tokenize('/')[-1]},short_name=gnomAD_SV,format=vcf,type=overlap,overlap_cutoff=${params.overlap_cutoff},fields=AF%AF_afr%AF_ami%AF_amr%AF_asj%AF_eas%AF_fin%AF_mid%AF_nfe%AF_rmi%AF_sas"
            if ( params.sv_clinvar ) flags << "--custom file=${params.sv_clinvar.tokenize('/')[-1]},short_name=ClinVar_SV,format=vcf,type=overlap,overlap_cutoff=${params.overlap_cutoff},fields=CLNSIG%CLNACC"
            flags ? "${base} ${flags.join(' ')}" : base
        }
        ext.prefix = { "${meta.id}.merged.annotated.vep" }
    }

    withName: '.*:ANNOTATIONS_SV:ENSEMBLVEP_FILTERVEP' {
        ext.args   = ''
        ext.prefix = { "${meta.id}.merged.annotated.vep" }
    }

    withName: 'ENSEMBLVEP_DOWNLOAD' {
        ext.args = '--NO_HTSLIB --AUTO cf --NO_UPDATE'
        // Reaches ftp.ensembl.org; behind a proxy the env-file supplies
        // http_proxy/https_proxy/ftp_proxy/no_proxy to the container.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
        errorStrategy = 'retry'
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/vep_cache" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  publishDir: merge_sv subworkflow 
    // Produces: {outdir}/merge_sv/{tool}/{subtool}
    // e.g. merge_sv/bcftools/sort, merge_sv/svdb/merge, merge_sv/minda
    withName: '.*:MERGE_SV:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/merge_sv/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  publishDir: minda_annotations subworkflow 
    // Produces: {outdir}/minda_annotations/{tool}/{subtool}
    // e.g. minda_annotations/bcftools/annotate, minda_annotations/minda/extract_annotations
    withName: '.*:MINDA_ANNOTATIONS:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/minda_annotations/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  publishDir: annotations_sv subworkflow ─
    // Produces: {outdir}/annotations_sv/{tool}/{subtool_or_alias}
    withName: '.*:ANNOTATIONS_SV:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/annotations_sv/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  publishDir: SV_REPORT_INDEX  top-level sv_report/ directory.
    //
    //  DELIBERATELY UNANCHORED, and this selector covers BOTH renders of the
    //  two-pass report (SV_REPORT_INDEX and the pass-2 alias
    //  SV_REPORT_INDEX_COHORT), which is what we want: both publish into the same
    //  directory and pass 2, which depends on pass 1 through COHORT_MERGE_SV,
    //  always completes later and overwrites pass 1's index.html.
    //  DO NOT add a `$` here to try to separate the passes. Nextflow matches
    //  withName selectors as a SUBSTRING, so `'SV_REPORT_INDEX$'` still matched
    //  SV_REPORT_INDEX_COHORT.
    withName: 'SV_REPORT_INDEX' {
        publishDir = [
            path: { "${params.outdir}/sv_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  publishDir: IGVREPORTS  per-sample interactive HTML for pass2 SVs.
    // Regex matches all three aliased instances (IGVREPORTS_SMALL / _MED / _LARGE); per-bucket overrides for `ext.args` (flanking) and `ext.prefix`
    // live in the individual withName blocks below.
    withName: 'IGVREPORTS.*' {
        // `ext.genome` activates the local IGVREPORTS fork's `--genome` branch:
        // `create_report` then pulls the IGV-hosted genome bundle (RefSeq GENCODE gene track, chromosome ideogram, chromosome alias list)
        ext.genome = {
            params.genome == "GRCh38" ? "hg38" :
            params.genome == "GRCh37" ? "hg19" :
            params.genome
        }
        // Color + group BAM reads by HP haplotag (Nanopore-haplotagged data).
        ext.color_bam_by_hp = true
        //   showSoftClips:true   required to see breakpoint sequence in
        //   displayMode:SQUISHED  packs reads tightly so high-coverage
        //   samplingDepth:300  caps displayed reads per pixel; keeps HTML size smaller
        ext.bam_show_soft_clips = true
        ext.bam_display_mode    = 'SQUISHED'
        ext.bam_sampling_depth  = 300
        // Threads the outbound proxy env vars into this process's container.
        // NOTE: `params.proxy_env_file` is set globally in nextflow.config, NOT only under
        // the OPBG profile, so this applies on every profile. Set it to null/'' to disable.
        // `containerOptions` is the per-process scope; `docker.runOptions` is global.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
        // Retry up to 3 times on transient container errors
        errorStrategy = 'retry'
        maxRetries    = 3
        publishDir = [
            path: { "${params.outdir}/igv_reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-bucket overrides. --flanking chosen to match the SVLEN cutoff of the
    // bucket: small (<1 kb) 1 kb of read-support context on each side of the
    // breakpoint; medium (1–10 kb) 5 kb; large (≥10 kb) or BND  20 kb
    // (bigger than typical Nanopore N50, so each breakpoint gets its own
    // viewport without the middle spanning). --maxlen 5000 forces split-screen
    // for any SV wider than 5 kb.
    withName: 'IGVREPORTS_SMALL' {
        // BEDPE sites; --merge-overlaps collapses same-anchor rows (SNVs, small
        // DELs) to single-locus while BND rows keep split-screen.
        ext.args   = '--flanking 1000 --maxlen 5000 --merge-overlaps'
        ext.prefix = { "${meta.id}.pass2.igv.small" }
    }
    withName: 'IGVREPORTS_MED' {
        ext.args   = '--flanking 5000 --maxlen 5000 --merge-overlaps'
        ext.prefix = { "${meta.id}.pass2.igv.medium" }
    }
    withName: 'IGVREPORTS_LARGE' {
        ext.args   = '--flanking 20000 --maxlen 5000 --merge-overlaps'
        ext.prefix = { "${meta.id}.pass2.igv.large" }
    }

    //  IGV_REPORTS_SV  bcftools query → per-sample TSV extract ─
    // The bcftools 1.20 biocontainer has no Python, so bcftools query runs
    // here (bcftools container) and the resulting TSV is consumed by
    // SV_TO_BEDPE in a Python container.
    withName: '.*:IGV_REPORTS_SV:BCFTOOLS_QUERY_SV_FIELDS' {
        ext.prefix = { "${meta.id}.pass2.sv.fields" }
    }
    withName: '.*:IGV_REPORTS_SV:BCFTOOLS_QUERY_SNV_FIELDS' {
        ext.prefix = { "${meta.id}.pass2.snv.fields" }
    }

    //  IGV_REPORTS_SV  SV → BEDPE converter (Python container) ─
    // Runs once per sample; emits three bucket-split BEDPE files consumed by
    // IGVREPORTS_SMALL/MED/LARGE. See spec 2026-07-06-igv-report-expansion-design.md.
    withName: '.*:IGV_REPORTS_SV:SV_TO_BEDPE' {
        ext.prefix = { "${meta.id}" }
    }

    //  ANNOTSV_INSTALLANNOTATIONS  — only runs when params.annotsv_annotations is null.
    //  Fetches the AnnotSV annotation bundle from www.lbgi.fr/AnnotSV and ftp.ncbi.nih.gov,
    //  so it needs the OPBG proxy env vars just like IGVREPORTS.
    withName: 'ANNOTSV_INSTALLANNOTATIONS' {
        publishDir = [
            path: { "${params.outdir}/annotsv/installannotations" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        // Threads the outbound proxy env vars into this process's container.
        // NOTE: `params.proxy_env_file` is set globally in nextflow.config, NOT only under
        // the OPBG profile, so this applies on every profile. Set it to null/'' to disable.
        // `containerOptions` is the per-process scope; `docker.runOptions` is global.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    //  publishDir: ANNOTSV_SETUPUSERANNO  (used by both SV and CNA)
    withName: 'ANNOTSV_SETUPUSERANNO' {
        publishDir = [
            path: { "${params.outdir}/annotsv/setupuseranno" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        // Threads the outbound proxy env vars into this process's container.
        // NOTE: `params.proxy_env_file` is set globally in nextflow.config, NOT only under
        // the OPBG profile, so this applies on every profile. Set it to null/'' to disable.
        // `containerOptions` is the per-process scope; `docker.runOptions` is global.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
        // The module falls back to a UCSC download of ncbiRefSeq.txt.gz when the
        // annotations bundle ships neither that file nor genes.RefSeq.sorted.bed,
        // so a transient network error should not fail the run outright.
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    //  SETUPCLINVAR 
    withName: 'SETUPCLINVAR' {
        ext.prefix = 'clinvar'
        publishDir = [
            path: { "${params.outdir}/setupclinvar" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    //  SETUPCIVIC — CSQ->CIVIC rename + chr-prefix, before the liftover
    withName: 'SETUPCIVIC' {
        ext.prefix = 'civic'
        publishDir = [
            path: { "${params.outdir}/reference/civic" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  publishDir: final merged+CALLER VCF  override for easy identification
    // BCFTOOLS_SORT_MERGED produces {sample}.merged.sorted.vcf.gz, which is the
    // merged Severus+SAVANA VCF carrying the CALLER INFO field from MINDA.
    withName: 'BCFTOOLS_SORT_MERGED|BCFTOOLS_INDEX_MERGED' {
        publishDir = [
            path: { "${params.outdir}/annotations_sv/merged_sv_caller" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  FILTER_SV pass 1 
    withName: 'VEMBRANE_FILTER_PASS1' {
        // Spec C: SPLIT_VEP_TO_INFO drops INFO/CSQ upstream, so vembrane never
        // needs the CSQ parser. Filter expressions use INFO.get("gnomAD_SV_AF")
        // instead of ANN.get()  no --annotation-key needed.
        ext.args   = ''
        ext.prefix = { "${meta.id}.merged.annotated.pass1" }
    }

    withName: 'BCFTOOLS_RESCUE_BND_PASS1' {
        ext.prefix = { "${meta.id}.merged.annotated.rescued.pass1" }
    }

    withName: '.*:FILTER_SV:BCFTOOLS_SORT_PASS1' {
        ext.prefix = { "${meta.id}.merged.annotated.rescued.sorted.pass1" }
    }

    withName: '.*:FILTER_SV:BCFTOOLS_VIEW_PASS1' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}.merged.annotated.filtered.pass1" }
    }

    withName: '.*:FILTER_SV:BCFTOOLS_INDEX_PASS1' {
        ext.args = '--tbi'
    }

    //  FILTER_SV pass 2 
    withName: 'VEMBRANE_FILTER_PASS2' {
        // Spec C: --annotation-key CSQ removed (see PASS1 comment).
        ext.args   = ''
        ext.prefix = { "${meta.id}.merged.annotated.pass2" }
    }

    withName: 'BCFTOOLS_RESCUE_BND_PASS2' {
        ext.prefix = { "${meta.id}.merged.annotated.rescued.pass2" }
    }

    withName: '.*:FILTER_SV:BCFTOOLS_SORT_PASS2' {
        ext.prefix = { "${meta.id}.merged.annotated.rescued.sorted.pass2" }
    }

    withName: '.*:FILTER_SV:BCFTOOLS_VIEW_PASS2' {
        ext.args   = '-Oz'
        ext.prefix = { "${meta.id}.merged.annotated.filtered.pass2" }
    }

    withName: '.*:FILTER_SV:BCFTOOLS_INDEX_PASS2' {
        ext.args = '--tbi'
    }

    withName: '.*:FILTER_SV:STRIP_FLAG_CSQ' {
        ext.prefix = { "${meta.id}.merged.annotated.csq_normalized" }
    }

    //  ANNOTATIONS_SV  SPLIT_VEP_TO_INFO ─
    // Extracts named CSQ subfields into top-level INFO/* and drops INFO/CSQ. any conditionally-absent INFO tag reduces to an
    // empty column / False without further branching.
    withName: '.*:ANNOTATIONS_SV:SPLIT_VEP_TO_INFO' {
        ext.split_vep_fields = {
            def fields = []
            if ( params.sv_vcf     ) fields.addAll( [ 'gnomAD_SV:String', 'gnomAD_SV_AF:Float' ] )
            if ( params.sv_clinvar ) fields << 'ClinVar_SV_CLNSIG:String'
            fields.join(',')
        }
        ext.prefix           = { "${meta.id}.merged.annotated.vep" }
    }

    //  FILTER_SV table export ─
    // single unified header (VEP-on / VEP-off use the same columns).
    // gnomAD_SV + gnomAD_SV_AF always present; populated by SPLIT_VEP_TO_INFO when VEP on, empty strings when VEP off. 
    withName: 'VEMBRANE_TABLE_PASS1' {
        ext.args   = "--header 'CHROM,POS,CytoBand,ID,REF,ALT,SVTYPE,DETAILED_TYPE,SVLEN,END,CALLER,PRECISE,SAVANA_SVTYPE,Annotation_mode,Gene_name,Gene_count,Closest_left,Closest_right,Location,Overlapped_CDS_percent,Frameshift,Dist_nearest_SS,Nearest_SS_type,RE_gene,ACMG_class,ACMG,AnnotSV_ranking_score,AnnotSV_ranking_criteria,P_gain_source,P_gain_phen,P_loss_source,P_loss_phen,P_ins_source,P_ins_phen,B_gain_source,B_loss_source,name_ST17_BND,name_ST17_DEL,name_ST17_DUP,name_ST17_INS,name_ST17_INV,score_ST17_BND,score_ST17_DEL,score_ST17_DUP,score_ST17_INS,score_ST17_INV,GT,VAF,hVAF,DR,DV,gnomAD_SV,gnomAD_SV_AF,ClinVar_SV_CLNSIG,TUMOUR_READ_SUPPORT,TUMOUR_AF,CLASS'"
        ext.prefix = { "${meta.id}.merged.annotated.filtered.pass1" }
    }

    withName: 'VEMBRANE_TABLE_PASS2' {
        ext.args   = "--header 'CHROM,POS,CytoBand,ID,REF,ALT,SVTYPE,DETAILED_TYPE,SVLEN,END,CALLER,PRECISE,SAVANA_SVTYPE,Annotation_mode,Gene_name,Gene_count,Closest_left,Closest_right,Location,Overlapped_CDS_percent,Frameshift,Dist_nearest_SS,Nearest_SS_type,RE_gene,ACMG_class,ACMG,AnnotSV_ranking_score,AnnotSV_ranking_criteria,P_gain_source,P_gain_phen,P_loss_source,P_loss_phen,P_ins_source,P_ins_phen,B_gain_source,B_loss_source,name_ST17_BND,name_ST17_DEL,name_ST17_DUP,name_ST17_INS,name_ST17_INV,score_ST17_BND,score_ST17_DEL,score_ST17_DUP,score_ST17_INS,score_ST17_INV,GT,VAF,hVAF,DR,DV,gnomAD_SV,gnomAD_SV_AF,ClinVar_SV_CLNSIG,TUMOUR_READ_SUPPORT,TUMOUR_AF,CLASS'"
        ext.prefix = { "${meta.id}.merged.annotated.filtered.pass2" }
    }

    // Data-dictionary prefixes — per-variant-type suffix so files from all three
    // filter subworkflows are unambiguous in the SV_REPORT_INDEX staging area.
    // Filename pattern: `<meta.id>.<sv|cna|snv>.data_dict.tsv`. The
    // `.*:FILTER_XX:.*` publishDir wildcards below place each under its own
    // filter_XX/create/data_dict_XX/ directory.
    withName: '.*:FILTER_SV:CREATE_DATA_DICT_SV' {
        ext.prefix = { "${meta.id}.sv" }
    }
    withName: '.*:FILTER_CNA:CREATE_DATA_DICT_CNA' {
        ext.prefix = { "${meta.id}.cna" }
    }
    withName: '.*:FILTER_SNV:CREATE_DATA_DICT_SNV' {
        ext.prefix = { "${meta.id}.snv" }
    }

    //  publishDir: filter_sv subworkflow 
    // Produces: {outdir}/filter_sv/{tool}/{subtool}
    // e.g. filter_sv/vembrane/filter, filter_sv/bcftools/rescue_bnd
    withName: '.*:FILTER_SV:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/filter_sv/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  ANNOTATIONS_CNA  per-process overrides ─
    withName: '.*:ANNOTATIONS_CNA:BCFTOOLS_REHEADER' {
        ext.args2  = '--output-type v'
        ext.prefix = { "${meta.id}.${meta.variant_type}.reheadered" }
    }

    withName: '.*:ANNOTATIONS_CNA:BCFTOOLS_RENAME_IDS' {
        // options for bcftools annotate
        ext.args = ''
        // options for tabix
        ext.args2 = '-0' 
        ext.prefix = { "${meta.id}.wakhan.renamed" }
    }

    withName: '.*:ANNOTATIONS_CNA:BCFTOOLS_ADD_CALLER_TAG' {
        ext.prefix = { "${meta.id}.wakhan.caller_tag" }
    }

    withName: '.*:ANNOTATIONS_CNA:BCFTOOLS_SORT_CNA' {
        ext.prefix = { "${meta.id}.wakhan.sorted" }
    }

    withName: '.*:ANNOTATIONS_CNA:ANNOTSV_ANNOTSV' {
        ext.args   = "-SVinputInfo 1 -vcf 1 -genomeBuild ${params.genome}"
        ext.prefix = { "${meta.id}.cna.annotated" }
        // Threads the outbound proxy env vars into this process's container.
        // NOTE: `params.proxy_env_file` is set globally in nextflow.config, NOT only under
        // the OPBG profile, so this applies on every profile. Set it to null/'' to disable.
        // `containerOptions` is the per-process scope; `docker.runOptions` is global.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
    }

    withName: '.*:ANNOTATIONS_CNA:BCFTOOLS_REHEADER_WAKHAN_FMT' {
        ext.prefix = { "${meta.id}.cna.annotated" }
    }

    withName: '.*:ANNOTATIONS_CNA:VEMBRANE_TABLE_CALLER' {
        ext.args   = "--header 'ID,CALLER,TCN,CN1,CN2,CNQ1,CNQ2,COV1,COV2'"
        ext.prefix = { "${meta.id}.cna.caller_lookup" }
    }

    withName: '.*:ANNOTATIONS_CNA:ADD_CALLER' {
        ext.prefix = { "${meta.id}.cna.annotated" }
    }

    withName: '.*:ANNOTATIONS_CNA:BCFTOOLS_INDEX_CNA' {
        ext.args = '--tbi'
    }

    withName: '.*:ANNOTATIONS_CNA:KNOTANNOTSV_HTML' {
        ext.args      = { params.genome == "GRCh38" ? "--genomeBuild hg38" : "--genomeBuild ${params.genome}" }
        ext.prefix    = { "${meta.id}.cna.annotated" }
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
        publishDir    = [
            path: { "${params.outdir}/annotations_cna/knotannotsv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANNOTATIONS_CNA:KNOTANNOTSV_XL' {
        ext.args      = { params.genome == "GRCh38" ? "--genomeBuild hg38" : "--genomeBuild ${params.genome}" }
        ext.prefix    = { "${meta.id}.cna.annotated.xl" }
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
        publishDir    = [
            path: { "${params.outdir}/annotations_cna/knotannotsv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Catch-all publishDir for the CNA annotation subworkflow.
    withName: '.*:ANNOTATIONS_CNA:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/annotations_cna/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  FILTER_CNA  per-process overrides 

    withName: '.*:FILTER_CNA:BCFTOOLS_NORM_CNA' {
        // -m -any splits every multi-allelic record so vembrane's one-ALT-per-record constraint is satisfied.
        // -N  no left-alignment / REF-trimming to avoid FASTA sequence lookup
        ext.prefix = { "${meta.id}.cna.norm" }
        ext.args   = '-m -any --do-not-normalize --write-index=tbi -Oz'
    }

    withName: '.*:FILTER_CNA:VEMBRANE_FILTER_PASS1' {
        ext.prefix = { "${meta.id}.cna.filtered.pass1" }
    }

    withName: '.*:FILTER_CNA:VEMBRANE_FILTER_PASS2' {
        ext.prefix = { "${meta.id}.cna.filtered.pass2" }
    }

    withName: '.*:FILTER_CNA:BCFTOOLS_SORT_PASS1' {
        ext.prefix = { "${meta.id}.cna.filtered.pass1.sorted" }
    }

    withName: '.*:FILTER_CNA:BCFTOOLS_SORT_PASS2' {
        ext.prefix = { "${meta.id}.cna.filtered.pass2.sorted" }
    }

    withName: '.*:FILTER_CNA:BCFTOOLS_VIEW_PASS1' {
        ext.args   = "-Oz --write-index=tbi"
        ext.prefix = { "${meta.id}.cna.filtered.pass1" }
    }

    withName: '.*:FILTER_CNA:BCFTOOLS_VIEW_PASS2' {
        ext.args   = "-Oz --write-index=tbi"
        ext.prefix = { "${meta.id}.cna.filtered.pass2" }
    }

    withName: '.*:FILTER_CNA:BCFTOOLS_INDEX_PASS1' {
        ext.args = '--tbi'
    }

    withName: '.*:FILTER_CNA:BCFTOOLS_INDEX_PASS2' {
        ext.args = '--tbi'
    }

    withName: '.*:FILTER_CNA:VEMBRANE_TABLE_PASS1' {
        // BPS: comma-joined Severus IDs supporting the segment breakpoints
        // (Wakhan's SV-linkage). Column MUST stay 1:1 with the table_cols
        // list in subworkflows/local/filter_cna/main.nf — BPS follows
        // WAKHAN_ID, before GT.
        ext.args   = "--header 'CHROM,POS,CytoBand,ID,REF,ALT,SVTYPE,SVLEN,END,CALLER,HET,Annotation_mode,Gene_name,Gene_count,Closest_left,Closest_right,Location,Overlapped_CDS_percent,Frameshift,RE_gene,ACMG_class,ACMG,AnnotSV_ranking_score,AnnotSV_ranking_criteria,P_gain_source,P_gain_phen,P_loss_source,P_loss_phen,P_ins_source,B_gain_source,B_loss_source,name_ST19_Alterations.CNV.Recurrent_AMP,name_ST19_Alterations.CNV.Recurrent_DEL,name_ST19_Alterations.CNV.Recurrent_GAIN,name_ST19_Alterations.CNV.Recurrent_LOSS,score_ST19_Alterations.CNV.Recurrent_AMP,score_ST19_Alterations.CNV.Recurrent_DEL,score_ST19_Alterations.CNV.Recurrent_GAIN,score_ST19_Alterations.CNV.Recurrent_LOSS,WAKHAN_ID,BPS,GT,TCN,CN1,CN2,CNQ1,CNQ2,COV1,COV2'"
        ext.prefix = { "${meta.id}.cna.filtered.pass1" }
    }

    withName: '.*:FILTER_CNA:VEMBRANE_TABLE_PASS2' {
        // BPS column matches pass1 header — see comment above.
        ext.args   = "--header 'CHROM,POS,CytoBand,ID,REF,ALT,SVTYPE,SVLEN,END,CALLER,HET,Annotation_mode,Gene_name,Gene_count,Closest_left,Closest_right,Location,Overlapped_CDS_percent,Frameshift,RE_gene,ACMG_class,ACMG,AnnotSV_ranking_score,AnnotSV_ranking_criteria,P_gain_source,P_gain_phen,P_loss_source,P_loss_phen,P_ins_source,B_gain_source,B_loss_source,name_ST19_Alterations.CNV.Recurrent_AMP,name_ST19_Alterations.CNV.Recurrent_DEL,name_ST19_Alterations.CNV.Recurrent_GAIN,name_ST19_Alterations.CNV.Recurrent_LOSS,score_ST19_Alterations.CNV.Recurrent_AMP,score_ST19_Alterations.CNV.Recurrent_DEL,score_ST19_Alterations.CNV.Recurrent_GAIN,score_ST19_Alterations.CNV.Recurrent_LOSS,WAKHAN_ID,BPS,GT,TCN,CN1,CN2,CNQ1,CNQ2,COV1,COV2'"
        ext.prefix = { "${meta.id}.cna.filtered.pass2" }
    }

    // Catch-all publishDir for the CNA filter subworkflow.
    withName: '.*:FILTER_CNA:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/filter_cna/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  MERGE_SNV subworkflow 

    withName: '.*:MERGE_SNV:BCFTOOLS_NORM_CLAIRSTO' {
        ext.prefix = { "${meta.id}.clairsto.norm" }
        ext.args   = '-c w -m -both --write-index=tbi -Oz'
    }
    withName: '.*:MERGE_SNV:BCFTOOLS_NORM_DEEPSOMATIC' {
        ext.prefix = { "${meta.id}.deepsomatic.norm" }
        ext.args   = '-m -both --write-index=tbi -Oz'
    }
    withName: '.*:MERGE_SNV:BCFTOOLS_VIEW_PASS_CLAIRSTO' {
        ext.prefix = { "${meta.id}.clairsto.pass" }
        ext.args   = '-f PASS --write-index=tbi -Oz'
    }
    withName: '.*:MERGE_SNV:BCFTOOLS_VIEW_PASS_DEEPSOMATIC' {
        ext.prefix = { "${meta.id}.deepsomatic.pass" }
        ext.args   = '-f PASS --write-index=tbi -Oz'
    }
    withName: '.*:MERGE_SNV:BCFTOOLS_ISEC' {
        ext.args   = '-n+2 -c none -Oz --write-index=tbi'
    }
    withName: '.*:MERGE_SNV:RENAME_CLAIRSTO' {
        ext.prefix = { "${meta.id}.clairsto" }
    }
    withName: '.*:MERGE_SNV:RENAME_DEEPSOMATIC' {
        ext.prefix = { "${meta.id}.deepsomatic" }
    }
    withName: '.*:MERGE_SNV:VIEW_TO_INFO_CLAIRSTO' {
        ext.prefix = { "${meta.id}.clairsto" }
    }
    withName: '.*:MERGE_SNV:VIEW_TO_INFO_DEEPSOMATIC' {
        ext.prefix = { "${meta.id}.deepsomatic" }
    }
    withName: '.*:MERGE_SNV:BCFTOOLS_ANNOTATE_CROSS_CALLER' {
        ext.prefix = { "${meta.id}.cross_caller" }
        ext.args   = '-c INFO/DEEPSOMATIC_VAF,INFO/DEEPSOMATIC_DP --write-index=tbi -Oz'
    }
    // NOTE: prefixes below are caller-specific (not shared across the
    // CLAIRSTO/DEEPSOMATIC pair) because RESCUE_FLAG_* outputs are staged
    // together as siblings into the same MERGE_SNV_CONCAT_RESCUE task — an
    // identical basename for both would be a file-name collision there.
    withName: '.*:MERGE_SNV:RESCUE_VIEW_CLAIRSTO' {
        ext.args   = '--write-index=tbi -Oz'
        ext.prefix = { "${meta.id}.clairsto.rescue" }
    }
    withName: '.*:MERGE_SNV:RESCUE_VIEW_DEEPSOMATIC' {
        ext.args   = '--write-index=tbi -Oz'
        ext.prefix = { "${meta.id}.deepsomatic.rescue" }
    }
    withName: '.*:MERGE_SNV:RESCUE_FLAG_CLAIRSTO' {
        // BED columns: CHROM, FROM, TO, gene -> INFO/RESCUED
        ext.args   = '-c CHROM,FROM,TO,RESCUED --write-index=tbi -Oz'
        ext.prefix = { "${meta.id}.clairsto.rescue.flagged" }
    }
    withName: '.*:MERGE_SNV:RESCUE_FLAG_DEEPSOMATIC' {
        // BED columns: CHROM, FROM, TO, gene -> INFO/RESCUED
        ext.args   = '-c CHROM,FROM,TO,RESCUED --write-index=tbi -Oz'
        ext.prefix = { "${meta.id}.deepsomatic.rescue.flagged" }
    }
    // Sample-name normalisation ahead of MERGE_SNV_CONCAT_RESCUE — see the
    // comment in subworkflows/local/merge_snv/main.nf above `concat_in` for
    // why this must run BEFORE the concat rather than only at the tail of
    // the subworkflow. Prefixes are caller/stream-distinct (not shared)
    // because all three outputs are staged together as siblings into the
    // same MERGE_SNV_CONCAT_RESCUE task — an identical basename for any two
    // of them would be a file-name collision there, same class of bug as
    // the note on RESCUE_VIEW_* above.
    withName: '.*:MERGE_SNV:RESCUE_REHEADER_CONSENSUS' {
        ext.prefix = { "${meta.id}.consensus.rescue.reheadered" }
        ext.args2  = '-Oz --write-index=tbi'
    }
    withName: '.*:MERGE_SNV:RESCUE_REHEADER_CLAIRSTO' {
        ext.prefix = { "${meta.id}.clairsto.rescue.reheadered" }
        ext.args2  = '-Oz --write-index=tbi'
    }
    withName: '.*:MERGE_SNV:RESCUE_REHEADER_DEEPSOMATIC' {
        ext.prefix = { "${meta.id}.deepsomatic.rescue.reheadered" }
        ext.args2  = '-Oz --write-index=tbi'
    }
    withName: '.*:MERGE_SNV:RESCUE_SUBTRACT_CLAIRSTO' {
        ext.prefix = { "${meta.id}.clairsto.rescue.subtracted" }
    }
    withName: '.*:MERGE_SNV:RESCUE_SUBTRACT_DEEPSOMATIC' {
        ext.prefix = { "${meta.id}.deepsomatic.rescue.subtracted" }
    }

    withName: '.*:MERGE_SNV:MERGE_SNV_CONCAT_RESCUE' {
        // -a allows overlapping records; -D drops duplicates by POS/REF/ALT so a
        // variant present in both the consensus and a rescue stream appears once.
        ext.args   = '-a -D --write-index=tbi -Oz'
        ext.prefix = { "${meta.id}.consensus.rescued" }
    }
    withName: '.*:MERGE_SNV:BCFTOOLS_SORT_MERGE_SNV' {
        ext.prefix = { "${meta.id}.consensus.snv" }
        ext.args   = '--write-index=tbi -Oz'
    }

    // Sample-column rename to meta.id — mirrors MERGE_SV pattern. Emit tbi
    // via reheader's built-in --write-index path so a separate BCFTOOLS_INDEX
    // process isn't needed; the sort's original tbi is invalidated once the
    // header length changes (BGZF block offsets shift), so re-index is required.
    withName: '.*:MERGE_SNV:BCFTOOLS_REHEADER' {
        ext.prefix = { "${meta.id}.consensus.snv.reheadered" }
        ext.args2  = '-Oz --write-index=tbi'
    }
    //  publishDir: merge_snv subworkflow 
    // Produces: {outdir}/merge_snv/{tool}/{subtool}
    // e.g. merge_snv/bcftools/norm_clairsto, merge_snv/bcftools/isec,
    //      merge_snv/bcftools/annotate_cross_caller, merge_snv/qc/merge_snv
    // Same splitter as MERGE_SV / ANNOTATIONS_SV / ANNOTATIONS_CNA: take the
    // last token of the process's fully-qualified name, split on the first
    // underscore, and use the two halves as tool / subtool. `saveAs` drops
    // versions.yml so it doesn't clutter the publish tree.
    withName: '.*:MERGE_SNV:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/merge_snv/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  ANNOTATIONS_SNV subworkflow 

    withName: '.*:ANNOTATIONS_SNV:BCFTOOLS_ANNOTATE_CLINVAR_SNV' {
        ext.prefix = { "${meta.id}.clinvar" }
        ext.args   = [
            '-c',
            'INFO/CLNSIG,INFO/CLNDN,INFO/CLNREVSTAT,INFO/CLNHGVS,INFO/CLNVI,' +
            'INFO/GENEINFO,INFO/RS,' +
            'INFO/SCI,INFO/SCIDN,INFO/SCIREVSTAT,INFO/SCIDISDB,' +
            'INFO/ONC,INFO/ONCDN,INFO/ONCREVSTAT,INFO/ONCCONF,INFO/ONCDISDB',
            '--pair-logic exact',
            '--write-index=tbi -Oz'
        ].join(' ')
    }
    withName: '.*:ANNOTATIONS_SNV:BCFTOOLS_ANNOTATE_CIVIC_SNV' {
        ext.prefix = { "${meta.id}.civic" }
        ext.args   = [
            '-c',
            'INFO/VT,INFO/CIVIC',
            '--pair-logic exact',
            '--write-index=tbi -Oz'
        ].join(' ')
    }

    //  CIViC reference prep: sanitize -> liftover GRCh37 -> GRCh38 -> index
    withName: '.*:PREPARE_REFERENCES:BCFTOOLS_SANITIZE_VCF' {
        ext.prefix = 'civic.sanitized'
        // Drops the spec-invalid REF==ALT record natively; the module's sed
        // handles the whitespace bcftools cannot rewrite.
        ext.args   = "-e 'REF=ALT'"
        publishDir = [
            path: { "${params.outdir}/reference/civic" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PREPARE_REFERENCES:PICARD_CREATESEQUENCEDICTIONARY' {
        // picard resolves the dictionary as <fasta-basename>.dict, so the
        // prefix must track the FASTA name rather than meta.id.
        ext.prefix = { fasta.baseName }
    }

    withName: '.*:PREPARE_REFERENCES:LIFTOVER_CIVIC' {
        ext.prefix = 'civic.GRCh38'
        // WARN_ON_MISSING_CONTIG: CIViC carries contigs absent from the chain;
        // warn rather than abort the whole reference build.
        ext.args   = '--WARN_ON_MISSING_CONTIG true'
        // LiftoverVcf walks the entire reference; the 3 GB default heap OOMs
        // on GRCh38. The module derives -Xmx from task.memory.
        memory     = { 8.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/reference/civic" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PREPARE_REFERENCES:BCFTOOLS_INDEX_CIVIC' {
        ext.args   = '--tbi'
        publishDir = [
            path: { "${params.outdir}/reference/civic" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PREPARE_REFERENCES:BUILD_RESCUE_BED' {
        ext.prefix = 'rescue_regions'
        publishDir = [
            path: { "${params.outdir}/reference/rescue" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: '.*:ANNOTATIONS_SNV:ENSEMBLVEP_VEP_SNV' {
        ext.prefix = { "${meta.id}.vep" }
        // VEP 115: To annotate gnomAD genome and gnomAD exome frequencies, need both flags ('--af_gnomade', '--af_gnomadg')
        ext.args   = [
            '--offline', 
            '--vcf', '--canonical', 
            '--pick_allele_gene',
            '--sift b', '--polyphen b',
            '--af_gnomade', '--af_gnomadg',
            '--vcf_info_field CSQ',
            '--no_stats',
            '--compress_output bgzip'
        ].join(' ')
        // Threads the outbound proxy env vars into this process's container.
        // NOTE: `params.proxy_env_file` is set globally in nextflow.config, NOT only under
        // the OPBG profile, so this applies on every profile. Set it to null/'' to disable.
        // `containerOptions` is the per-process scope; `docker.runOptions` is global.
        containerOptions = params.proxy_env_file? "--env-file ${params.proxy_env_file}": ''
    }
    withName: '.*:ANNOTATIONS_SNV:BCFTOOLS_SORT_ANNOTATIONS_SNV' {
        ext.prefix = { "${meta.id}.annotated.snv" }
        ext.args   = '--write-index=tbi -Oz'
    }
    //  publishDir: annotations_snv subworkflow 
    // Produces: {outdir}/annotations_snv/{tool}/{subtool}
    // e.g. annotations_snv/bcftools/annotate_clinvar_snv,
    //      annotations_snv/ensemblvep/vep_snv,
    //      annotations_snv/bcftools/sort_annotations_snv
    // Same splitter as MERGE_SV / ANNOTATIONS_SV / ANNOTATIONS_CNA.
    withName: '.*:ANNOTATIONS_SNV:.*' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1].toLowerCase()
                def idx  = proc.indexOf('_')
                def tool_path = idx > 0 ? "${proc[0..(idx-1)]}/${proc[(idx+1)..-1]}" : proc
                "${params.outdir}/annotations_snv/${tool_path}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //  FILTER_SNV subworkflow ─

    withName: '.*:FILTER_SNV:VEMBRANE_FILTER_WITH_AUX' {
        ext.prefix = { "${meta.id}.snv.unsorted" }
        ext.args   = '--annotation-key CSQ'
    }
    withName: '.*:FILTER_SNV:BCFTOOLS_SORT_FILTER_SNV' {
        ext.prefix = { "${meta.id}.snv.filtered" }
        ext.args   = '--write-index=tbi -Oz'
    }
    withName: '.*:FILTER_SNV:VEMBRANE_TABLE_SNV' {
        ext.prefix = { "${meta.id}.snv.filtered" }
        // vembrane table auto-prepends a SAMPLE column to BOTH the main expression and the --header
        ext.args   = "--header 'CHROM,POS,ID,REF,ALT,CALLER,CLAIRSTO_VAF,CLAIRSTO_DP,DEEPSOMATIC_VAF,DEEPSOMATIC_DP,Consequence,IMPACT,SYMBOL,BIOTYPE,Feature,HGVSc,HGVSp,SIFT,PolyPhen,gnomADg_AF,gnomADe_AF,CLNSIG,CLNDN,CLNREVSTAT,SCI,SCIDN,SCIREVSTAT,ONC,ONCDN,ONCREVSTAT,ONCCONF,GENEINFO,RS,VT,CIVIC' --annotation-key CSQ"
    }
    withName: '.*:FILTER_SNV:.*' {
        publishDir = [
            path: { "${params.outdir}/filter_snv" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi,tsv}'
        ]
    }

    // ── Cohort SV merge (part 1 of 3) ──────────────────────────────────────────
    withName: '.*:COHORT_MERGE_SV:COLLECT_COORDINATES' {
        ext.prefix = 'cohort_sv.regions'
        publishDir = [
            path: { "${params.outdir}/cohort_merge_sv" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }
    withName: '.*:COHORT_MERGE_SV:COHORT_SV_SET_ID' {
        // Prefix every ID with the sample so Jasmine's IDLIST is joinable back to
        // (SAMPLE, ID) in the report TSV. Replaces make_unique_ids.py.
        // --write-index is REQUIRED: the .tbi emit is `optional: true`, so without it the
        // downstream .join() would silently yield nothing.
        ext.args   = { "--set-id '${meta.id}_%ID' --write-index=tbi -Oz" }
        ext.prefix = { "${meta.id}.cohort.uid" }
    }
    withName: '.*:COHORT_MERGE_SV:COHORT_SV_RESTRICT' {
        ext.args   = '--write-index=tbi -Oz'
        ext.prefix = { "${meta.id}.cohort.regions" }
    }
    withName: '.*:COHORT_MERGE_SV:COHORT_SV_RECORDS' {
        // No ext.args: the query projection is a val input, not a config arg, so the module
        // stays reusable. Prefix only, to keep the collectFile inputs distinct.
        ext.prefix = { "${meta.id}.cohort.records" }
    }
    withName: '.*:COHORT_MERGE_SV:JASMINE_COHORT' {
        // --nonlinear_dist is MANDATORY, not tuning: without it BNDs (SVLEN=0) are pinned to
        // a flat 100bp tolerance that max_dist cannot raise, and none of this cohort's BND
        // rows would ever cluster. It makes max_dist the sole, flat gate.
        // --dup_to_ins is safe: the module always passes genome_file=<fasta>, which Jasmine
        // requires for that option.
        //
        // --centroid_merging bounds cluster WIDTH. Jasmine's default linkage is single-link,
        // so transitively-close variants chain: measured 2026-09-17, four samples at +400bp
        // steps collapse into ONE cluster even though the extremes are 1200bp apart at
        // max_dist=500. With --centroid_merging they correctly split into two. It does NOT
        // cost legitimate merges (a 400bp-offset pair still merges; an offset BND mate pair
        // still merges), and it is the setting used by the reference implementation
        // (jasmine_sv_annotations, Hiatt 2024, Genome Research).
        // This matters ONLY at scale: chaining cannot occur at N=2, so the 2-sample test set
        // can never exercise it, but the risk grows with cohort size. --clique_merging is
        // stricter still and judged too aggressive for noisy somatic breakpoints.
        //
        // Verify any new parameter against `jasmine --help` -- Jasmine SILENTLY IGNORES
        // unknown parameters, so a bad name sits here looking effective while doing nothing.
        // (The reference implementation passes '--min_sequence_id' and '--centroid-merging',
        // neither of which is a real Jasmine parameter -- both are silently discarded.)
        ext.args   = [
            '--output_genotypes',
            '--dup_to_ins',
            '--nonlinear_dist',
            '--centroid_merging',
            "max_dist=${params.cohort_sv_max_dist}",
            "min_overlap=${params.cohort_sv_min_overlap}",
            "min_seq_id=${params.cohort_sv_min_seq_id}"
        ].join(' ')
        ext.prefix = 'cohort.sv.jasmine'
    }
    withName: '.*:COHORT_MERGE_SV:COHORT_SV_SORT' {
        ext.args   = '--write-index=tbi -Oz'
        ext.prefix = 'cohort.sv.merged'
        publishDir = [
            path: { "${params.outdir}/cohort_merge_sv" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi}'
        ]
    }
    withName: '.*:COHORT_MERGE_SV:JASMINE_CLUSTER_MAP' {
        ext.prefix = 'cohort_sv_recurrent'
        publishDir = [
            path: { "${params.outdir}/cohort_merge_sv" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

}
