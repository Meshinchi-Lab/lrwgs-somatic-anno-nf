// modules/local/cohort_to_circos/tests/main.nf.test
nextflow_process {

    name "Test Process COHORT_TO_CIRCOS"
    script "../main.nf"
    process "COHORT_TO_CIRCOS"
    tag "modules"
    tag "genomic_viz"
    tag "cohort_to_circos"

    test("fixture - cohort and per-sample sets") {
        when {
            process {
                """
                def fx = "\${projectDir}/tests/fixtures/genomic_viz"
                input[0] = [ [ id: 'cohort' ], file("\${fx}/cohort_sv_pass2.tsv", checkIfExists: true) ]
                input[1] = file("\${fx}/cohort_cna_pass2.tsv", checkIfExists: true)
                input[2] = file("\${fx}/cohort_snv.tsv", checkIfExists: true)
                input[3] = file("\${fx}/cohort_sv_recurrent.map.tsv", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            def links  = process.out.links[0][1].collect { file(it) }.collectEntries { [ (it.name): it ] }
            def cna    = process.out.cna[0][1].collect { file(it) }.collectEntries { [ (it.name): it ] }
            def labels = process.out.labels[0][1].collect { file(it) }.collectEntries { [ (it.name): it ] }
            assert links.keySet() == ['cohort.links.txt', 'colo829.links.txt', 'coloSAV.links.txt'] as Set

            def cohort = links['cohort.links.txt'].readLines()
            assert cohort.size() == 5
            assert cohort.find { it.startsWith('hs14 99232731 99232731 hs5 171319244 171319244') }.endsWith('color=tier1,thickness=4p,z=3')
            // the BND3978 pair is listed _2 first in the fixture, so the _2 mate is the one kept: hs2 -> hs21
            assert cohort.find { it.startsWith('hs2 99727265 99727265 hs21 34816131 34816131') }.endsWith('color=tier1,thickness=4p,z=3')
            // intrachromosomal SVs are two single-base points: start on one end, END on the other
            assert cohort.find { it.startsWith('hs21 45000000 45000000 hs21 45015802 45015802') }.endsWith('color=tier2,thickness=3p,z=2')
            assert cohort.find { it.startsWith('hs21 34797509') }.endsWith('color=tier1,thickness=2p,z=3')
            assert cohort.find { it.startsWith('hs21 40028842 40028842 hs21 40033181 40033181') }.endsWith('color=tier3,thickness=2p,z=1')
            assert links['colo829.links.txt'].readLines().size() == 3
            assert links['coloSAV.links.txt'].readLines().size() == 2

            assert cna['cohort.cna.txt'].readLines() == [
                'hs21 13000001 31877979 color=gain',
                'hs21 31881348 40028842 color=gain',
                'hs21 13000001 31877979 color=loss' ]
            assert cna['coloSAV.cna.txt'].readLines().size() == 1

            def lab = labels['cohort.labels.txt'].readLines().collect { it.split(' ')[3] }
            assert lab as Set == ['BCL11B','RUNX1','AFF3','TLX3','OLIG2','IFNAR1','NOTCH1'] as Set
            assert lab.size() == 7                       // the second RUNX1 (34.80 Mb) was deduplicated into the 34 Mb bin
            assert labels['colo829.labels.txt'].readLines().size() == 5
            assert labels['coloSAV.labels.txt'].readLines().size() == 3

            def counts = file(process.out.counts[0][1]).readLines()
            // This header is read by the viz-circos-cohort chunk of bin/sv_report_index.qmd: keep the two in step.
            assert counts[0] == 'set\tlinks\ttiles\tlabels\tskipped_ins\tdup_mates\toff_karyotype\tbad_breakpoint\tunknown_cna_type'
            assert counts.find { it.startsWith('cohort\t') } == 'cohort\t5\t3\t7\t1\t2\t1\t0\t1'
            assert counts.find { it.startsWith('colo829\t') } == 'colo829\t3\t2\t5\t1\t2\t0\t0\t0'
            assert counts.find { it.startsWith('coloSAV\t') } == 'coloSAV\t2\t1\t3\t0\t0\t1\t0\t1'
        }
    }

    test("no recurrence map, no snv - uniform thickness") {
        when {
            process {
                """
                def fx = "\${projectDir}/tests/fixtures/genomic_viz"
                input[0] = [ [ id: 'cohort' ], file("\${fx}/cohort_sv_pass2.tsv", checkIfExists: true) ]
                input[1] = file("\${fx}/cohort_cna_pass2.tsv", checkIfExists: true)
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assert process.success
            def cohort = process.out.links[0][1].collect { file(it) }.find { it.name == 'cohort.links.txt' }.readLines()
            assert cohort.size() == 5
            assert cohort.every { it.contains('thickness=3p') }
            def lab = process.out.labels[0][1].collect { file(it) }.find { it.name == 'cohort.labels.txt' }.readLines()
            assert lab.size() == 6     // NOTCH1 (SNV) absent
        }
    }

    test("edge cases - sanitised sample name, label fallback, non-numeric END, header-only cna") {
        when {
            process {
                """
                def fx = "\${projectDir}/tests/fixtures/genomic_viz"
                input[0] = [ [ id: 'cohort' ], file("\${fx}/c2c_edge.sv.tsv", checkIfExists: true) ]
                input[1] = file("\${fx}/c2c_edge.cna.tsv", checkIfExists: true)
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assert process.success
            def links  = process.out.links[0][1].collect { file(it) }.collectEntries { [ (it.name): it ] }
            def labels = process.out.labels[0][1].collect { file(it) }.collectEntries { [ (it.name): it ] }
            assert links.keySet() == ['cohort.links.txt', 'P_1_a.links.txt'] as Set            // 'P 1/a' sanitised
            assert links['P_1_a.links.txt'].readLines() == [ 'hs1 1000000 1000000 hs2 2000000 2000000 color=tier1,thickness=3p,z=3' ]
            assert labels['P_1_a.labels.txt'].readLines() == [ 'hs1 1000000 1000000 GENEA' ]   // fallback: first Gene_name_display token
            def counts = file(process.out.counts[0][1]).readLines()
            assert counts.find { it.startsWith('P_1_a\t') } == 'P_1_a\t1\t0\t1\t0\t0\t0\t1\t0'   // DEL with END=NA -> bad_breakpoint
            assert counts.find { it.startsWith('cohort\t') } == 'cohort\t1\t0\t1\t0\t0\t0\t1\t0'
        }
    }

    test("missing required column fails fast") {
        when {
            process {
                """
                def fx = "\${projectDir}/tests/fixtures/genomic_viz"
                input[0] = [ [ id: 'cohort' ], file("\${fx}/c2c_bad.sv.tsv", checkIfExists: true) ]
                input[1] = file("\${fx}/cohort_cna_pass2.tsv", checkIfExists: true)
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assert process.failed
            // nf-test's process.stderr is the Nextflow launcher's own stderr; the task's error block
            // ("Command error:" with .command.err) is reported on Nextflow's stdout.
            assert (process.stdout + process.stderr).any { it.contains('lacks required column') && it.contains('breakpoint') }
        }
    }

    test("a sample named cohort is rejected") {
        when {
            process {
                """
                def fx = "\${projectDir}/tests/fixtures/genomic_viz"
                input[0] = [ [ id: 'cohort' ], file("\${fx}/c2c_cohort_name.sv.tsv", checkIfExists: true) ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assert process.failed
            assert (process.stdout + process.stderr).any { it.contains("collides with the cohort track set") }
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                def fx = "\${projectDir}/tests/fixtures/genomic_viz"
                input[0] = [ [ id: 'cohort' ], file("\${fx}/cohort_sv_pass2.tsv", checkIfExists: true) ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assert process.success
            assert file(process.out.counts[0][1]).readLines().any { it.startsWith('stub\t') }
        }
    }
}
