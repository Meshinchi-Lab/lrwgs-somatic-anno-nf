/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Site-specific scratch paths belong in a profile, never in the global default:
// a hard-coded absolute path makes the pipeline unrunnable anywhere else.
// The OPBG profile below reads NXF_ANNO_WORKDIR from the environment.
workDir = './work'

// Global default params, used in configs
params {

    // Input and output options
    input                       = 'data/2025-07-24-AIEOP-BFM_T-ALL_wgs_nanopore_batches_samplesheet.csv'
    sample_metadata             = 'data/2025-07-24-AIEOP-BFM_T-ALL_wgs_nanopore_wf_metadata.csv'         // optional path to cohort metadata CSV; null skips merge
    ensembl_db                  = 'data/reference/EnsDb.Hsapiens.v110.sqlite'                           // optional path to an Ensembl DB (e.g. EnsDb sqlite) surfaced to the SV_REPORT_INDEX qmd via params$ensembl_db; null = not staged
    outdir                      = 'results/patient_ctrl_samples'
    publish_dir_mode            = 'symlink'


    // References
    genome                     = "GRCh38"
    fasta                      = "data/reference/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"
    get_sizes                  = 'false'
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false

    /*
        Structural Variant Options
    */
    // SAVANA
    pon_1kg                     = "1000g_hg38"
    min_support                 = 3     // default is 3 
    allele_min_reads            = 10    // default is 10
    main_cn_step_change         = 1     //the default is 1
    contigs_file                = 'https://raw.githubusercontent.com/cortes-ciriano-lab/savana/refs/heads/main/example/contigs.chr.hg38.txt'

    // Merge with MINDA
    sv_merge_size               = "100"

    // AnnotSV
    annotsv_annotations         = "data/reference/AnnotSV"        // path to pre-built AnnotSV DB; null triggers auto-download
    candidateGenesFile          = 'data/reference/genomic_basis_tall/ST9.alterations_OncoKB_cancer_genes.txt'      // path to genes of interest

    // ── SNV candidate-gene rescue ──────────────────────────────────────
    // Recovers single-caller PASS SNVs inside candidate-gene regions that the
    // `bcftools isec -n+2` consensus would otherwise discard.
    rescue_snv                  = true
    rescue_genes_file           = null   // null = fall back to candidateGenesFile
    rescue_promoter_pad         = 2000   // strand-aware upstream padding, bp

    FtIncludedInSV              = ['data/reference/genomic_basis_tall/ST17_Alterations.SV.All_DEL.bed','data/reference/genomic_basis_tall/ST17_Alterations.SV.All_DUP.bed','data/reference/genomic_basis_tall/ST17_Alterations.SV.All_INS.bed','data/reference/genomic_basis_tall/ST17_Alterations.SV.All_INV.bed']
    SVincludedInFt              = []
    AnyOverlap                  = ['data/reference/genomic_basis_tall/ST17_Alterations.SV.All_BND.bed']
    add_savana_sv               = false       // true = concat Severus + SAVANA-only into AnnotSV input; false = Severus-only (smaller KnotAnnotSV html)

    // VEP for SVs
    sv_anno_vep                 = 'true'
    sv_vcf                      = 'data/gnomad_sv_cnv/gnomad.v4.1.sv.sites.vcf.gz'
    sv_clinvar                  = 'data/clinvar/nstd102.GRCh38.variant_call.vcf.gz'

    /*
        Copy Number Alteration Options
    */
    // AnnotSV — CNA user BEDs (ST19 Recurrent_AMP/DEL/GAIN/LOSS)
    run_cna_anno                = 'true'
    cna_FtIncludedInSV          = [
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_AMP.bed',
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_DEL.bed',
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_GAIN.bed',
        'data/reference/genomic_basis_tall/ST19_Alterations.CNV.Recurrent_LOSS.bed'
    ]
    cna_SVincludedInFt          = []
    cna_AnyOverlap              = []

    // ── Cohort SV merge (part 1 of 3) ──────────────────────────────────
    // Clusters SVs ACROSS cohort samples so the same event called at slightly
    // different breakpoints/lengths is recognised as one recurrent variant.
    // Runs AFTER SV_REPORT_INDEX because driver_tier exists only in the report layer.
    run_cohort_merge_sv         = true
    cohort_sv_max_dist          = 500    // PRIMARY clustering gate, bp, applied FLAT
                                         // because --nonlinear_dist is mandatory (see
                                         // conf/modules.config). Calibrated 2026-09-17:
                                         // BND pairs merge at >=300, a 1kb-offset DEL
                                         // needs >=1000. 500 is the conservative middle.
    // NB: there is deliberately NO cohort_sv_max_dist_linear param. Jasmine's length-scaled
    // threshold is max(min_dist, max_dist_linear x SVLEN), and BNDs carry SVLEN=0, which
    // pins them to a flat 100bp that max_dist cannot raise. --nonlinear_dist disables
    // length-scaling entirely and is REQUIRED for BND clustering (10 of 14 tiered rows in
    // the test set are BND), which makes max_dist_linear inert.
    cohort_sv_min_overlap       = 0.5    // secondary, applies within max_dist. Per
                                         // `jasmine --help` this is "the minimum reciprocal
                                         // overlap for DEL/INV/DUP SVs" -- NOT BND.
    cohort_sv_min_seq_id        = 0.5    // applies to INSERTIONS only, so inert for this
                                         // BND/DEL-dominated set; kept permissive because
                                         // ONT breakpoints are noisy and calls are somatic.
    cohort_sv_min_recurrence    = 2      // n_tiered required to set cohort_recurrent
    cohort_sv_region_pad        = 1000   // BED padding, MUST be >= cohort_sv_max_dist or
                                         // region-restriction defeats fuzzy matching

    // CNA annotations
    cnv_vcf                     = 'data/gnomad_sv_cnv/gnomad.v4.1.cnv.all.vcf.gz'

    /*
        Single Nucleotide Variants / INDEL Options
    */
    run_snv_anno               = 'true'
    clinvar_snv_vcf            = 'data/clinvar/clinvar_20260627.vcf.gz'
    // CIViC publishes GRCh37 coordinates only (`civicpy create-vcf` has no build
    // flag), so PREPARE_REFERENCES lifts it to GRCh38 with picard LiftoverVcf
    // before use. Annotating GRCh38 calls against the raw release matched nothing.
    civic_snv_vcf              = 'data/reference/01-Jul-2026-civic_accepted.vcf.gz'
    civic_chain                = 'data/reference/hg19ToHg38.over.chain.gz'
    snv_min_vaf                = 0.05    // both callers must show >= this VAF
    snv_gnomad_af_max          = 0.01    // gnomAD AF cutoff for soft PoN

    // VEP
    species                     = 'homo_sapiens'
    cache_version               = '115'
    vep_cache                   = 'data/vep'   // path to pre-built VEP cache directory; null skips VEP annotation
    include_cache               = false      // when vep_cache is null: true = ENSEMBLVEP_DOWNLOAD fetches the cache; false = VEP runs --offline with --custom files only
    vep_extra_files             = []     // list of extra files staged into the VEP working dir (plugins, custom annotations)
    overlap_cutoff              = '80'
    
    // KnotAnnotSV
    knot_config                 = './config_AnnotSV.yaml' // customize the knotannotSV html output

    // Outbound proxy env-file, injected into egress-needing containers
    // (IGVREPORTS, ENSEMBLVEP, ANNOTSV, ...) as `docker --env-file` via the
    // per-process `containerOptions` in conf/modules.config.
    //
    // MUST default to null. Docker itself fails with
    //   exit 125: open <path>: no such file or directory
    // on EVERY process carrying the option when the path does not exist, which
    // is what happens on any host but the one the old default was written for.
    // Set it per site (see the OPBG profile) or with --proxy_env_file <path>.
    proxy_env_file              = null

    // Locally-staged cytoband ideogram for IGV_REPORTS
    // When null, igv-reports fetches from UCSC at runtime. Setting this with file a file, bypasses the download step, if encountering an curl/ssl errors
    cytoband_ideo               = 'data/reference/cytoBandIdeo.hg38.txt.gz'
    gnomad_sv_track             = "${params.sv_vcf}"   // population-SV annotation track shown in IGV reports; set to null to skip
    gnomad_sv_tbi               = "${params.sv_vcf}.tbi"
    tcr_gene_ref                = "data/reference/HGNC_TCR_genes.tsv"

    // ProteinPaint DISCO plot params (see nextflow.config for details)
    disco_enable                = true
    proteinpaint_host           = 'https://proteinpaint.stjude.org'
    proteinpaint_genome         = 'hg38'

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    // ── OPBG profile ───────────────────────────────────────────────────────
    // Mirrors the `docker` profile but flags a proxy env-file path that
    // modules.config injects into the IGVREPORTS container via per-process `containerOptions`.
    // allow container to reach `igv.org` for the --genome hg38 bundle JSON.
    OPBG {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
        // Site-specific paths are read from the ENVIRONMENT so that no host,
        // mount point or user directory is committed to the repository.
        // Export on the OPBG nodes (e.g. in ~/.bash_profile):
        //   NXF_ANNO_PROXY_ENV  docker --env-file holding the outbound proxy vars
        //   NXF_ANNO_WORKDIR    scratch directory for Nextflow's work/
        //
        // NB the previous line here was
        //   params.proxy_env_file = "${params.proxy_env_file}"
        // a self-assignment no-op, so the value it appeared to scope to this
        // profile was in fact the global default and applied on every profile.
        params.proxy_env_file   = System.getenv('NXF_ANNO_PROXY_ENV')
        workDir                 = System.getenv('NXF_ANNO_WORKDIR') ?: './work'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}



// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'Meshinchi-Lab/2026-04-30_wgs_nanopore_variantcallinganno'
    contributors    = [
        [
            name: 'Jenny L. Smith',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/Meshinchi-Lab/2026-04-30_wgs_nanopore_variantcallinganno'
    description     = """A pipeline to merge multiple sources of SVs, CNVs, and SNVs and annotate them with known and custom reference DBs."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
